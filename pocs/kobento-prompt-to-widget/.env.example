# Optional LLM API keys for natural-language widget generation.
# Without an API key, the studio runs in offline mode using curated presets
# and prompt keyword matching.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server port (defaults to 4173)
PORT=4173
